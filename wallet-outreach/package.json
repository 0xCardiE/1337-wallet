{
  "name": "wallet-outreach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "test": "tsx --test server/voice.test.ts",
    "loop": "tsx server/scripts/loop.ts",
    "x:setup": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
