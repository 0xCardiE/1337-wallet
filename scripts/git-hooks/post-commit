#!/bin/sh
# Rebuild unpacked dist/ after commit and ask Chrome to reload 1337.
# Detach fully — git waits for the hook process group, including `&` children.
if [ -n "$CI" ]; then
  exit 0
fi
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
mkdir -p "$root/node_modules/.cache"
echo "1337: rebuilding unpacked extension in the background"
(
  export SKIP_IF_LOCKED=1
  nohup node "$root/scripts/rebuild-extension.mjs" \
    >>"$root/node_modules/.cache/1337-ext-rebuild.log" 2>&1
) </dev/null >/dev/null 2>&1 &
exit 0
