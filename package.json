{
  "name": "1337-wallet",
  "version": "2.2.2",
  "description": "An EVM wallet for hackers. Readable confirms, easy RPC switching, hardware. No analytics. No tracking server.",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "allow-scripts run",
    "dev": "node scripts/watch-extension.mjs",
    "dev:ext": "node scripts/watch-extension.mjs",
    "build": "NODE_ENV=production webpack --config webpack.config.cjs && NODE_ENV=production webpack --config webpack.ui.config.cjs && NODE_ENV=production webpack --config webpack.content.config.cjs",
    "package:store": "node scripts/package-store-zip.mjs",
    "ext:rebuild": "node scripts/rebuild-extension.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build:policy": "LAVAMOAT_GENERATE_POLICY=1 NODE_ENV=production webpack --config webpack.config.cjs && LAVAMOAT_GENERATE_POLICY=1 NODE_ENV=production webpack --config webpack.ui.config.cjs",
    "lavamoat:check": "node scripts/check-lavamoat-policy.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "build:watch": "npm run dev:ext",
    "preview": "npx serve dist",
    "icons": "python3 scripts/generate-brand-marks.py && node scripts/generate-extension-icons.mjs",
    "store:assets": "node scripts/generate-store-listing-assets.mjs",
    "store:frames": "node scripts/generate-store-listing-assets.mjs --frames-only",
    "store:site-shots": "node scripts/generate-store-listing-assets.mjs --site-shots",
    "update-chain-dex-ranks": "node scripts/fetch-defillama-chain-dex-volume.mjs",
    "wallet-research": "npm run dev --prefix wallet-research",
    "wallet-research:x-login": "npm run x:login --prefix wallet-research",
    "wallet-research:x-setup": "npm run x:setup --prefix wallet-research",
    "wallet-research:x-cookies": "npm run x:cookies --prefix wallet-research",
    "wallet-research:search": "npm run search --prefix wallet-research",
    "wallet-research:export": "npm run export --prefix wallet-research",
    "website": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "website:deploy": "bash scripts/deploy-website.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@ledgerhq/hw-app-eth": "^7.8.11",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@lifi/sdk": "^3.16.3",
    "@trezor/connect-webextension": "^9.7.3",
    "buffer": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1",
    "viem": "^2.25.0"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.0",
    "@lavamoat/webpack": "^2.2.4",
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "overrides": {
    "ses": "2.2.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail#3.0.0": false,
      "@ledgerhq/hw-app-eth>@ledgerhq/domain-service>eip55>keccak#3.0.4": false,
      "@lifi/sdk>@solana/web3.js>jayson>ws>utf-8-validate#5.0.10": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/blockchain-link-utils>@trezor/protobuf>protobufjs#7.4.0": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/blockchain-link>@stellar/stellar-sdk#14.2.0": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/device-authenticity>@trezor/protobuf>protobufjs#7.4.0": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/protobuf>protobufjs#7.5.5": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/transport>usb#2.18.0": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/utxo-lib>blake-hash#2.0.0": false,
      "@trezor/connect-webextension>@trezor/connect>@trezor/utxo-lib>tiny-secp256k1#1.1.7": false,
      "viem>ws>bufferutil#4.1.0": false,
      "viem>ws>utf-8-validate#6.0.6": false,
      "esbuild-loader>esbuild#0.28.2": true
    }
  }
}
